# LOAD-SPAN Environment Configuration
# Copy this file to .env and modify values as needed

# Application Settings
APP_NAME=LOAD-SPAN
APP_VERSION=1.0.0
ENVIRONMENT=production

# Database Configuration (if applicable)
DATABASE_URL=postgresql://user:password@localhost/load_span
DATABASE_POOL_SIZE=10

# Sensor Data Stream Configuration
SENSOR_STREAM_ENABLED=true
SENSOR_STREAM_PORT=8080
SENSOR_BUFFER_SIZE=4096
SAMPLE_RATE_HZ=200

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# AI Model Configuration
AI_MODEL_PATH=/models/load_span_xgboost.json
AI_FORECAST_HORIZON_HOURS=48
AI_PHYSICS_CONSTRAINED=true

# Monitoring Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/load_span/load_span.log

# Archival Settings
ARCHIVAL_PATH=/data/load_span/archival
ARCHIVAL_CHECKSUM_ENABLED=true
ARCHIVAL_RETENTION_DAYS=365

# Safety Thresholds
LSII_STEADY_STATE=0.90
LSII_MONITORING=0.75
LSII_MITIGATION=0.65
BETA_TARGET=3.8
D_FATIGUE_LIMIT=0.80
LAMBDA_CR_MIN=2.0
R_STRUCT_MIN=0.70

# Notification Settings
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_FROM=alerts@load-span.io
ALERT_EMAIL_TO=engineer@load-span.io

# Security
SECRET_KEY=change-this-in-production
JWT_EXPIRATION_HOURS=24

# Development Only
DEBUG=false
TESTING=false
